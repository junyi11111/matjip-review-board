# 이 파일을 .env로 복사한 뒤 JWT_SECRET을 새 난수(64자리 16진수 = 32바이트)로 바꾸세요.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 아래 값은 자리표시자이며, 그대로 두면 서버가 시작을 거부합니다. 실제 .env는 커밋하지 않습니다.
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
JWT_ISSUER=webservice-class
JWT_AUDIENCE=board-api
TOKEN_TTL=90
DB_FILE=data/board.sqlite
PORT=8000
